<template>
  <div class="page">
    <text class="percent">{{percentText}}</text>
    <text class="detail">{{detailText}}</text>
  </div>
</template>

<script>
import sensor from '@system.sensor'
import brightness from '@system.brightness'

// Escala logaritmica: 0 lx -> 0%, 10000 lx (o mas) -> 100%.
// Se usa log porque la luz ambiental va de ~0 lx (oscuridad) a ~50000 lx
// (exterior soleado) y una escala lineal dejaria casi todo en 0%.
const MAX_LUX = 10000
const LOG_MAX = Math.log(MAX_LUX + 1)

// Distintas versiones de Vela exponen el sensor de luz con nombres distintos,
// asi que se prueban en orden y se usa el primero que exista.
const SUBSCRIBE_NAMES = ['subscribeLight', 'subscribeAmbientLight', 'subscribeLightSensor']
const LUX_KEYS = ['intensity', 'value', 'lux', 'light', 'illuminance']

let activeName = ''
let gotData = false
let watchdog = null

function luxToPercent(lux) {
  if (!(lux >= 0)) return 0
  const pct = Math.round((Math.log(lux + 1) / LOG_MAX) * 100)
  if (pct < 0) return 0
  if (pct > 100) return 100
  return pct
}

function readLux(ret) {
  if (ret === null || ret === undefined) return -1
  if (typeof ret === 'number') return ret
  for (let i = 0; i < LUX_KEYS.length; i++) {
    const v = ret[LUX_KEYS[i]]
    if (typeof v === 'number') return v
  }
  return -1
}

export default {
  private: {
    percentText: '--%',
    detailText: 'iniciando...'
  },

  onShow() {
    try {
      brightness.setKeepScreenOn({ keepScreenOn: true })
    } catch (e) {
      console.log('keepScreenOn no disponible: ' + e)
    }
    this.startSensor()
  },

  onHide() {
    this.stopSensor()
  },

  onDestroy() {
    this.stopSensor()
  },

  startSensor() {
    const self = this
    gotData = false

    for (let i = 0; i < SUBSCRIBE_NAMES.length; i++) {
      const name = SUBSCRIBE_NAMES[i]
      if (typeof sensor[name] !== 'function') continue
      try {
        sensor[name]({
          callback(ret) {
            self.onLight(ret)
          },
          fail(data, code) {
            self.percentText = '--%'
            self.detailText = 'error sensor (' + code + ')'
          }
        })
        activeName = name
        break
      } catch (e) {
        console.log('fallo ' + name + ': ' + e)
      }
    }

    if (!activeName) {
      this.percentText = '--%'
      this.detailText = 'sensor de luz no disponible'
      return
    }

    this.detailText = 'esperando datos...'
    watchdog = setTimeout(function () {
      if (!gotData) {
        self.detailText = 'sin datos del sensor'
      }
    }, 4000)
  },

  stopSensor() {
    if (watchdog) {
      clearTimeout(watchdog)
      watchdog = null
    }
    if (!activeName) return
    const stopName = activeName.replace('subscribe', 'unsubscribe')
    try {
      if (typeof sensor[stopName] === 'function') sensor[stopName]()
    } catch (e) {
      console.log('fallo ' + stopName + ': ' + e)
    }
    activeName = ''
  },

  onLight(ret) {
    const lux = readLux(ret)
    if (lux < 0) {
      this.detailText = 'dato no reconocido'
      return
    }
    gotData = true
    this.percentText = luxToPercent(lux) + '%'
    this.detailText = Math.round(lux) + ' lx'
  }
}
</script>

<style>
.page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  background-color: #000000;
}

.percent {
  font-size: 80px;
  color: #ffffff;
  text-align: center;
}

.detail {
  font-size: 22px;
  color: #9e9e9e;
  text-align: center;
  margin-top: 8px;
}
</style>
