<template>
  <div class="page" onclick="nextPage">
    <text class="tag">{{tagText}}</text>
    <text class="big">{{percentText}}</text>
    <text class="line">{{sourceText}}</text>
    <text class="body">{{pageText}}</text>
    <text class="foot">{{footText}}</text>
  </div>
</template>

<script>
import sensor from '@system.sensor'
import brightness from '@system.brightness'
import device from '@system.device'

// __VARIANT__ lo sustituye el script de build (RELEASE / DEBUG).
const VARIANT = '__VARIANT__'
const VERSION = '1.3.0'
const POLL_MS = 700
const CHUNK = 330

// Barrido amplio: se resuelven dinamicamente, los que no existen dan undefined.
const PROBE_MODULES = [
  'system.sensor', 'system.sensors', 'system.sensorhub', 'system.light',
  'system.ambientlight', 'system.ambientLight', 'system.als', 'system.lightsensor',
  'system.brightness', 'system.device', 'system.app', 'system.health',
  'system.fitness', 'system.sport', 'system.wear', 'system.miwear',
  'system.motion', 'system.step', 'system.heartrate', 'system.battery',
  'system.power', 'system.storage', 'system.prompt', 'system.router',
  'system.vibrator', 'system.network', 'system.file', 'system.configuration',
  'system.interconnect', 'system.alarm', 'system.audio', 'system.notification',
  'system.screen', 'system.display', 'system.hardware', 'system.systeminfo',
  'system.watchface', 'system.env', 'service.sensor'
]
const LIGHT_RE = /light|lux|ambient|illum|\bals\b/i
// Modulos cuyos metodos merece la pena listar (los estandar se omiten).
const DETAIL_RE = /sensor|light|als|brightness|device|app|health|fitness|sport|wear|motion|step|heart|screen|display|hardware|systeminfo|watchface|env|battery|power/i

let timer = null
let lastErr = ''

function note(e) {
  lastErr = ('' + e).slice(0, 50)
}

function requireModule(name) {
  try {
    /* eslint-disable no-undef */
    if (typeof $app_require$ === 'function') {
      const m = $app_require$('@app-module/' + name)
      return m && m.default ? m.default : m
    }
    /* eslint-enable no-undef */
  } catch (e) {
    note(e)
  }
  return undefined
}

function keysOf(obj) {
  const out = []
  if (obj === undefined || obj === null) return out
  const push = function (k) {
    if (k !== 'constructor' && out.indexOf(k) < 0) out.push(k)
  }
  try {
    for (const k in obj) push(k)
  } catch (e) {
    note(e)
  }
  try {
    Object.keys(obj).forEach(push)
  } catch (e) {
    note(e)
  }
  try {
    Object.getOwnPropertyNames(obj).forEach(push)
  } catch (e) {
    note(e)
  }
  try {
    const proto = Object.getPrototypeOf(obj)
    if (proto && proto !== Object.prototype) Object.getOwnPropertyNames(proto).forEach(push)
  } catch (e) {
    note(e)
  }
  return out
}

function chunk(title, text) {
  const out = []
  const body = text || '-'
  for (let i = 0; i < body.length; i += CHUNK) {
    const part = body.slice(i, i + CHUNK)
    out.push(title + (i ? '+' : '') + '\n' + part)
  }
  return out
}

export default {
  private: {
    tagText: '',
    percentText: '--%',
    sourceText: '',
    pageText: 'toca para ver paginas',
    footText: '',
    pages: [],
    idx: 0
  },

  onShow() {
    this.tagText = VARIANT + ' ' + VERSION
    this.idx = 0
    try {
      this.scan()
    } catch (e) {
      note(e)
      this.pageText = 'fallo scan: ' + lastErr
    }
    this.startBrightness()
  },

  onHide() {
    if (timer) {
      clearInterval(timer)
      timer = null
    }
  },

  onDestroy() {
    this.onHide()
  },

  scan() {
    const found = []
    const lightHits = []
    const sections = []

    for (let i = 0; i < PROBE_MODULES.length; i++) {
      const name = PROBE_MODULES[i]
      let mod = requireModule(name)
      if (mod === undefined) {
        if (name === 'system.sensor') mod = sensor
        if (name === 'system.brightness') mod = brightness
        if (name === 'system.device') mod = device
      }
      if (mod === undefined || mod === null) continue

      const short = name.replace('system.', '').replace('service.', 's:')
      found.push(short)
      const ks = keysOf(mod)
      for (let j = 0; j < ks.length; j++) {
        if (LIGHT_RE.test(ks[j])) lightHits.push(short + '.' + ks[j])
      }
      // Solo se detallan los modulos poco conocidos o relevantes.
      if (ks.length && DETAIL_RE.test(name)) sections.push([short, ks.join(',')])
    }

    let pages = []
    pages = pages.concat(chunk('LUZ?', lightHits.length ? lightHits.join(' ') : 'ninguna clave de luz'))
    pages = pages.concat(chunk('modulos(' + found.length + ')', found.join(',')))
    for (let i = 0; i < sections.length; i++) {
      pages = pages.concat(chunk(sections[i][0], sections[i][1]))
    }

    // Claves del objeto global del runtime, por si hay algo util ahi.
    try {
      /* eslint-disable no-undef */
      if (typeof global !== 'undefined') {
        pages = pages.concat(chunk('global', keysOf(global).join(',')))
      }
      /* eslint-enable no-undef */
    } catch (e) {
      note(e)
    }

    this.pages = pages
    this.render()
  },

  render() {
    if (!this.pages || !this.pages.length) {
      this.pageText = 'sin datos'
      return
    }
    this.pageText = this.pages[this.idx]
    this.footText = (this.idx + 1) + '/' + this.pages.length + (lastErr ? ' e:' + lastErr : '')
  },

  nextPage() {
    if (!this.pages || !this.pages.length) return
    this.idx = (this.idx + 1) % this.pages.length
    this.render()
  },

  startBrightness() {
    const self = this
    if (!brightness || typeof brightness.getValue !== 'function') return
    const read = function () {
      try {
        brightness.getValue({
          success(data) {
            const v = data && typeof data.value === 'number' ? data.value : -1
            if (v < 0) return
            self.percentText = Math.round((v / 255) * 100) + '%'
            self.sourceText = 'brillo ' + v + '/255'
          }
        })
      } catch (e) {
        note(e)
      }
    }
    read()
    timer = setInterval(read, POLL_MS)
  }
}
</script>

<style>
.page {
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  width: 100%;
  height: 100%;
  background-color: #000000;
  padding: 6px;
  padding-top: 10px;
}

.tag {
  font-size: 16px;
  color: #ff7043;
  text-align: center;
}

.big {
  font-size: 40px;
  color: #ffffff;
  text-align: center;
}

.line {
  font-size: 14px;
  color: #cccccc;
  text-align: center;
}

.body {
  font-size: 11px;
  color: #8ab4f8;
  text-align: center;
  margin-top: 6px;
}

.foot {
  font-size: 11px;
  color: #777777;
  text-align: center;
  margin-top: 4px;
}
</style>
