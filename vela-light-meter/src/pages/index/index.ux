<template>
  <div class="page">
    <text class="big">{{percentText}}</text>
    <text class="line">{{statusText}}</text>
    <text class="small">{{lcText}}</text>
    <text class="small">{{modText}}</text>
    <text class="tiny">{{keysText}}</text>
    <text class="tiny">{{errText}}</text>
  </div>
</template>

<script>
import sensor from '@system.sensor'
import brightness from '@system.brightness'
import device from '@system.device'

const MAX_LUX = 10000
const LOG_MAX = Math.log(MAX_LUX + 1)

// Nombres posibles del metodo de suscripcion al sensor de luz.
const SUBSCRIBE_NAMES = [
  'subscribeLight',
  'subscribeAmbientLight',
  'subscribeLightSensor',
  'subscribeIlluminance',
  'subscribeAls'
]
const LUX_KEYS = ['intensity', 'value', 'lux', 'light', 'illuminance', 'als']

// Modulos que se intentan resolver dinamicamente para ver cuales existen.
const PROBE_MODULES = [
  'system.sensor',
  'system.sensors',
  'system.light',
  'system.ambientlight',
  'system.health',
  'system.wear',
  'system.brightness',
  'system.device'
]

let activeName = ''
let activeMod = null
let lastErr = ''

function note(e) {
  lastErr = ('' + e).slice(0, 90)
}

function keysOf(mod) {
  const out = []
  if (mod === undefined || mod === null) return out
  try {
    for (const k in mod) {
      if (out.indexOf(k) < 0) out.push(k)
    }
  } catch (e) {
    note(e)
  }
  try {
    const ks = Object.keys(mod)
    for (let i = 0; i < ks.length; i++) {
      if (out.indexOf(ks[i]) < 0) out.push(ks[i])
    }
  } catch (e) {
    note(e)
  }
  try {
    const proto = Object.getPrototypeOf(mod)
    if (proto) {
      const ks = Object.getOwnPropertyNames(proto)
      for (let i = 0; i < ks.length; i++) {
        if (ks[i] !== 'constructor' && out.indexOf(ks[i]) < 0) out.push(ks[i])
      }
    }
  } catch (e) {
    note(e)
  }
  return out
}

function requireModule(name) {
  try {
    /* eslint-disable no-undef */
    if (typeof $app_require$ === 'function') {
      const m = $app_require$('@app-module/' + name)
      return m && m.default ? m.default : m
    }
    /* eslint-enable no-undef */
  } catch (e) {
    note(e)
  }
  return undefined
}

function luxToPercent(lux) {
  if (!(lux >= 0)) return 0
  const pct = Math.round((Math.log(lux + 1) / LOG_MAX) * 100)
  return pct < 0 ? 0 : pct > 100 ? 100 : pct
}

function readLux(ret) {
  if (ret === null || ret === undefined) return -1
  if (typeof ret === 'number') return ret
  for (let i = 0; i < LUX_KEYS.length; i++) {
    const v = ret[LUX_KEYS[i]]
    if (typeof v === 'number') return v
  }
  // Cualquier otra clave numerica sirve como ultimo recurso.
  try {
    const ks = Object.keys(ret)
    for (let i = 0; i < ks.length; i++) {
      if (typeof ret[ks[i]] === 'number') return ret[ks[i]]
    }
  } catch (e) {
    note(e)
  }
  return -1
}

export default {
  private: {
    percentText: '--%',
    statusText: 'arrancando',
    lcText: 'lc:',
    modText: '',
    keysText: '',
    errText: ''
  },

  onInit() {
    this.lcText = 'lc:I'
  },

  onReady() {
    this.lcText = this.lcText + 'R'
  },

  onShow() {
    this.lcText = this.lcText + 'S'
    try {
      this.inspect()
    } catch (e) {
      note(e)
      this.statusText = 'fallo inspect'
    }
    try {
      this.startSensor()
    } catch (e) {
      note(e)
      this.statusText = 'fallo start'
    }
    this.errText = lastErr ? 'err:' + lastErr : ''
  },

  onHide() {
    this.stopSensor()
  },

  onDestroy() {
    this.stopSensor()
  },

  // Muestra que modulos existen realmente en este firmware.
  inspect() {
    const found = []
    const missing = []
    let lightKeys = []
    let allKeys = []

    for (let i = 0; i < PROBE_MODULES.length; i++) {
      const name = PROBE_MODULES[i]
      let mod = requireModule(name)
      if (mod === undefined && name === 'system.sensor') mod = sensor
      if (mod === undefined && name === 'system.brightness') mod = brightness
      if (mod === undefined && name === 'system.device') mod = device

      if (mod === undefined || mod === null) {
        missing.push(name.replace('system.', ''))
        continue
      }
      found.push(name.replace('system.', ''))
      const ks = keysOf(mod)
      if (name === 'system.sensor' || name === 'system.sensors') {
        allKeys = allKeys.concat(ks)
      }
      for (let j = 0; j < ks.length; j++) {
        if (/light|lux|ambient|illum|als/i.test(ks[j]) && lightKeys.indexOf(ks[j]) < 0) {
          lightKeys.push(ks[j] + '@' + name.replace('system.', ''))
        }
      }
    }

    this.modText = 'ok:' + (found.join(',') || '-') + ' no:' + (missing.join(',') || '-')
    const luz = lightKeys.length ? 'LUZ:' + lightKeys.join(',') : 'LUZ: ninguna'
    this.keysText = (luz + ' | sensor:' + (allKeys.join(',') || '-')).slice(0, 400)
  },

  startSensor() {
    const self = this
    const mods = [sensor, requireModule('system.sensor'), requireModule('system.sensors')]

    for (let m = 0; m < mods.length; m++) {
      const mod = mods[m]
      if (mod === undefined || mod === null) continue
      for (let i = 0; i < SUBSCRIBE_NAMES.length; i++) {
        const name = SUBSCRIBE_NAMES[i]
        let fn
        try {
          fn = mod[name]
        } catch (e) {
          note(e)
          continue
        }
        if (typeof fn !== 'function') continue
        try {
          mod[name]({
            callback(ret) {
              self.onLight(ret)
            },
            fail(data, code) {
              self.statusText = 'fail ' + code
            }
          })
          activeName = name
          activeMod = mod
          self.statusText = 'esperando ' + name
          return
        } catch (e) {
          note(e)
        }
      }
    }
    this.statusText = 'sin API de luz'
  },

  stopSensor() {
    if (!activeName || !activeMod) return
    const stopName = activeName.replace('subscribe', 'unsubscribe')
    try {
      if (typeof activeMod[stopName] === 'function') activeMod[stopName]()
    } catch (e) {
      note(e)
    }
    activeName = ''
    activeMod = null
  },

  onLight(ret) {
    const lux = readLux(ret)
    if (lux < 0) {
      let dump = ''
      try {
        dump = JSON.stringify(ret).slice(0, 80)
      } catch (e) {
        dump = typeof ret
      }
      this.statusText = 'dato? ' + dump
      return
    }
    this.percentText = luxToPercent(lux) + '%'
    this.statusText = Math.round(lux) + ' lx'
  }
}
</script>

<style>
.page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  background-color: #000000;
  padding: 6px;
}

.big {
  font-size: 64px;
  color: #ffffff;
  text-align: center;
}

.line {
  font-size: 22px;
  color: #cccccc;
  text-align: center;
  margin-top: 4px;
}

.small {
  font-size: 15px;
  color: #8ab4f8;
  text-align: center;
  margin-top: 4px;
}

.tiny {
  font-size: 11px;
  color: #9e9e9e;
  text-align: center;
  margin-top: 3px;
}
</style>
