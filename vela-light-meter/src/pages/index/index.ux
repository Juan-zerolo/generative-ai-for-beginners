<template>
  <div class="page" onclick="onTap">
    <text class="big">{{percentText}}</text>
    <text class="line">{{sourceText}}</text>
    <text class="hint">{{hintText}}</text>
    <text class="tiny">{{diagText}}</text>
  </div>
</template>

<script>
import sensor from '@system.sensor'
import brightness from '@system.brightness'
import device from '@system.device'

const MAX_LUX = 10000
const LOG_MAX = Math.log(MAX_LUX + 1)
const POLL_MS = 700

// Por si algun firmware si expone sensor de luz.
const SUBSCRIBE_NAMES = ['subscribeLight', 'subscribeAmbientLight', 'subscribeLightSensor']
const LUX_KEYS = ['intensity', 'value', 'lux', 'light', 'illuminance']

let activeName = ''
let activeMod = null
let timer = null
let maxSeen = 0
let autoMode = -1
let lastErr = ''

function note(e) {
  lastErr = ('' + e).slice(0, 60)
}

function requireModule(name) {
  try {
    /* eslint-disable no-undef */
    if (typeof $app_require$ === 'function') {
      const m = $app_require$('@app-module/' + name)
      return m && m.default ? m.default : m
    }
    /* eslint-enable no-undef */
  } catch (e) {
    note(e)
  }
  return undefined
}

function luxToPercent(lux) {
  if (!(lux >= 0)) return 0
  const pct = Math.round((Math.log(lux + 1) / LOG_MAX) * 100)
  return pct < 0 ? 0 : pct > 100 ? 100 : pct
}

function readLux(ret) {
  if (ret === null || ret === undefined) return -1
  if (typeof ret === 'number') return ret
  for (let i = 0; i < LUX_KEYS.length; i++) {
    if (typeof ret[LUX_KEYS[i]] === 'number') return ret[LUX_KEYS[i]]
  }
  return -1
}

export default {
  private: {
    percentText: '--%',
    sourceText: 'midiendo...',
    hintText: '',
    diagText: ''
  },

  onShow() {
    this.readDevice()
    if (!this.startSensor()) this.startBrightness()
  },

  onHide() {
    this.stop()
  },

  onDestroy() {
    this.stop()
  },

  stop() {
    if (timer) {
      clearInterval(timer)
      timer = null
    }
    if (activeName && activeMod) {
      try {
        const stopName = activeName.replace('subscribe', 'unsubscribe')
        if (typeof activeMod[stopName] === 'function') activeMod[stopName]()
      } catch (e) {
        note(e)
      }
    }
    activeName = ''
    activeMod = null
  },

  // --- fuente 1: sensor de luz real, si el firmware lo expone ---
  startSensor() {
    const self = this
    const mods = [sensor, requireModule('system.sensor')]
    for (let m = 0; m < mods.length; m++) {
      const mod = mods[m]
      if (mod === undefined || mod === null) continue
      for (let i = 0; i < SUBSCRIBE_NAMES.length; i++) {
        const name = SUBSCRIBE_NAMES[i]
        let fn
        try {
          fn = mod[name]
        } catch (e) {
          note(e)
          continue
        }
        if (typeof fn !== 'function') continue
        try {
          mod[name]({
            callback(ret) {
              const lux = readLux(ret)
              if (lux < 0) return
              self.percentText = luxToPercent(lux) + '%'
              self.sourceText = Math.round(lux) + ' lx'
            }
          })
          activeName = name
          activeMod = mod
          return true
        } catch (e) {
          note(e)
        }
      }
    }
    return false
  },

  // --- fuente 2: brillo automatico de pantalla como aproximacion ---
  startBrightness() {
    const self = this
    if (!brightness || typeof brightness.getValue !== 'function') {
      this.percentText = '--%'
      this.sourceText = 'sin sensor ni brillo'
      return
    }

    this.checkMode()
    this.tick()
    timer = setInterval(function () {
      self.tick()
    }, POLL_MS)
  },

  checkMode() {
    const self = this
    try {
      brightness.getMode({
        success(data) {
          const m = data && data.mode !== undefined ? data.mode : data && data.value
          autoMode = typeof m === 'number' ? m : -1
          self.hintText = autoMode === 1 ? '' : 'toca para activar brillo automatico'
        },
        fail(data, code) {
          note('getMode ' + code)
        }
      })
    } catch (e) {
      note(e)
    }
  },

  tick() {
    const self = this
    try {
      brightness.getValue({
        success(data) {
          const v = data && typeof data.value === 'number' ? data.value : -1
          if (v < 0) {
            self.sourceText = 'brillo sin valor'
            return
          }
          if (v > maxSeen) maxSeen = v
          // El brillo va 0-100 o 0-255 segun firmware: se deduce del maximo visto.
          const scale = maxSeen > 100 ? 255 : 100
          let pct = Math.round((v / scale) * 100)
          if (pct > 100) pct = 100
          if (pct < 0) pct = 0
          self.percentText = pct + '%'
          self.sourceText = 'brillo ' + v + '/' + scale + (autoMode === 1 ? ' auto' : ' manual')
        },
        fail(data, code) {
          self.sourceText = 'getValue fail ' + code
        }
      })
    } catch (e) {
      note(e)
      this.sourceText = 'error brillo'
    }
  },

  // Tocar la pantalla activa el brillo automatico (sin el, el valor no cambia).
  onTap() {
    if (activeName) return
    try {
      if (typeof brightness.setMode === 'function') {
        const self = this
        brightness.setMode({
          mode: 1,
          success() {
            autoMode = 1
            self.hintText = 'brillo automatico ON'
            maxSeen = 0
          },
          fail(data, code) {
            self.hintText = 'setMode fail ' + code
          }
        })
      }
    } catch (e) {
      note(e)
    }
  },

  readDevice() {
    const self = this
    try {
      if (device && typeof device.getInfo === 'function') {
        device.getInfo({
          success(d) {
            const parts = []
            if (d.model) parts.push(d.model)
            if (d.osVersion) parts.push('os' + d.osVersion)
            if (d.platformVersionCode) parts.push('pv' + d.platformVersionCode)
            if (d.apiLevel) parts.push('api' + d.apiLevel)
            self.diagText = parts.join(' ') + (lastErr ? ' | ' + lastErr : '')
          },
          fail(data, code) {
            self.diagText = 'getInfo fail ' + code
          }
        })
      }
    } catch (e) {
      note(e)
    }
  }
}
</script>

<style>
.page {
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  background-color: #000000;
  padding: 6px;
}

.big {
  font-size: 76px;
  color: #ffffff;
  text-align: center;
}

.line {
  font-size: 20px;
  color: #cccccc;
  text-align: center;
  margin-top: 6px;
}

.hint {
  font-size: 15px;
  color: #ffb74d;
  text-align: center;
  margin-top: 8px;
}

.tiny {
  font-size: 11px;
  color: #777777;
  text-align: center;
  margin-top: 10px;
}
</style>
