<template>
  <stack class="page" onswipe="onSwipe" ontouchstart="onTouchStart" ontouchend="onTouchEnd" onlongpress="onLongPress" onclick="onTap">
    <div class="layer">
      <div class="header">
        <text class="score">{{score}}</text>
        <text class="arrow">{{arrow}}</text>
        <text class="best">{{bestText}}</text>
      </div>
      <div class="board">
        <div class="row"><div class="c {{$item}}" for="{{r0}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r1}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r2}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r3}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r4}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r5}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r6}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r7}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r8}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r9}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r10}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r11}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r12}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r13}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r14}}"></div></div>
        <div class="row"><div class="c {{$item}}" for="{{r15}}"></div></div>
      </div>
    </div>

    <div class="overlay" if="{{over}}">
      <text class="over1">GAME OVER</text>
      <text class="over2">{{score}} puntos</text>
      <div class="buttons">
        <text class="btn play" onclick="onPlay">JUGAR</text>
        <text class="btn quit" onclick="onQuit">SALIR</text>
      </div>
      <text class="over4">{{inputInfo}}</text>
    </div>
  </stack>
</template>

<script>
import brightness from '@system.brightness'
import vibrator from '@system.vibrator'
import storage from '@system.storage'
import app from '@system.app'
import router from '@system.router'

const COLS = 12
const ROWS = 16
const SPEED_START = 240
const SPEED_MIN = 110
const SPEED_STEP = 7
const ARROWS = { up: '^', down: 'v', left: '<', right: '>' }
const VARIANT = '__VARIANT__'

let board = []          // estado persistente del tablero: 'e' | 'h' | 'b' | 'f'
let dirty = []          // filas a repintar en este paso
let snake = []
let dir = 'right'
let pending = null
let food = { x: 6, y: 8 }
let timer = null
let speed = SPEED_START
let running = false
let touchX = 0
let touchY = 0
let lastInput = 'sin entrada'
let lastTickAt = 0
let tickMs = 0

function opposite(a, b) {
  return (a === 'up' && b === 'down') || (a === 'down' && b === 'up') ||
    (a === 'left' && b === 'right') || (a === 'right' && b === 'left')
}

function pointOf(e) {
  const list = (e && (e.changedTouches || e.touches)) || null
  const t = list && list.length ? list[0] : e
  if (!t) return null
  const x = t.clientX !== undefined ? t.clientX : (t.pageX !== undefined ? t.pageX : t.x)
  const y = t.clientY !== undefined ? t.clientY : (t.pageY !== undefined ? t.pageY : t.y)
  if (typeof x !== 'number' || typeof y !== 'number') return null
  return { x: x, y: y }
}

function buzz(ms) {
  try {
    if (vibrator && typeof vibrator.vibrate === 'function') vibrator.vibrate({ mode: ms })
  } catch (e) {
    console.log('vibrate: ' + e)
  }
}

export default {
  private: {
    score: 0,
    best: 0,
    bestText: '',
    arrow: '>',
    over: false,
    inputInfo: '',
    r0: [],
    r1: [],
    r2: [],
    r3: [],
    r4: [],
    r5: [],
    r6: [],
    r7: [],
    r8: [],
    r9: [],
    r10: [],
    r11: [],
    r12: [],
    r13: [],
    r14: [],
    r15: []
  },

  onInit() {
    this.loadBest()
  },

  onShow() {
    try {
      brightness.setKeepScreenOn({ keepScreenOn: true })
    } catch (e) {
      console.log('keepScreenOn: ' + e)
    }
    this.reset()
  },

  onHide() {
    this.stopLoop()
  },

  onDestroy() {
    this.stopLoop()
  },

  // --- pintado: solo las filas que cambian ---

  markDirty(y) {
    if (y >= 0 && y < ROWS) dirty[y] = true
  },

  setCell(x, y, v) {
    if (y < 0 || y >= ROWS || x < 0 || x >= COLS) return
    if (board[y][x] === v) return
    board[y][x] = v
    dirty[y] = true
  },

  // Reasignar la fila entera es lo unico que este runtime repinta:
  // mutar objetos anidados en un array no dispara render.
  flush() {
    for (let y = 0; y < ROWS; y++) {
      if (!dirty[y]) continue
      this['r' + y] = board[y].slice()
      dirty[y] = false
    }
  },

  redrawAll() {
    for (let y = 0; y < ROWS; y++) dirty[y] = true
    this.flush()
  },

  // --- ciclo de juego ---

  reset() {
    board = []
    dirty = []
    for (let y = 0; y < ROWS; y++) {
      const row = []
      for (let x = 0; x < COLS; x++) row.push('e')
      board.push(row)
      dirty.push(false)
    }

    const midY = Math.floor(ROWS / 2)
    snake = [{ x: 3, y: midY }, { x: 2, y: midY }, { x: 1, y: midY }]
    for (let i = 0; i < snake.length; i++) {
      board[snake[i].y][snake[i].x] = i === 0 ? 'h' : 'b'
    }

    dir = 'right'
    pending = null
    speed = SPEED_START
    tickMs = 0
    lastTickAt = 0
    this.score = 0
    this.arrow = ARROWS[dir]
    this.over = false
    this.placeFood()
    this.redrawAll()
    this.startLoop()
  },

  // Cadena de setTimeout en vez de setInterval: si un paso tarda de mas, no se
  // acumulan callbacks pendientes que ahoguen los gestos.
  startLoop() {
    const self = this
    this.stopLoop()
    running = true
    const step = function () {
      if (!running) return
      self.tick()
      if (running) timer = setTimeout(step, speed)
    }
    timer = setTimeout(step, speed)
  },

  stopLoop() {
    running = false
    if (timer) {
      clearTimeout(timer)
      timer = null
    }
  },

  tick() {
    if (this.over) return

    const now = Date.now()
    if (lastTickAt) tickMs = Math.round((tickMs * 3 + (now - lastTickAt)) / 4)
    lastTickAt = now

    if (pending && !opposite(pending, dir)) dir = pending
    pending = null

    const head = snake[0]
    let nx = head.x
    let ny = head.y
    if (dir === 'up') ny--
    else if (dir === 'down') ny++
    else if (dir === 'left') nx--
    else nx++

    if (nx < 0 || ny < 0 || nx >= COLS || ny >= ROWS) return this.gameOver()
    for (let i = 0; i < snake.length - 1; i++) {
      if (snake[i].x === nx && snake[i].y === ny) return this.gameOver()
    }

    const ate = nx === food.x && ny === food.y

    snake.unshift({ x: nx, y: ny })
    this.setCell(head.x, head.y, 'b')
    this.setCell(nx, ny, 'h')

    if (ate) {
      this.score = this.score + 1
      buzz(30)
      this.placeFood()
      if (speed > SPEED_MIN) speed = Math.max(SPEED_MIN, speed - SPEED_STEP)
    } else {
      const tail = snake.pop()
      this.setCell(tail.x, tail.y, 'e')
    }

    this.flush()
  },

  gameOver() {
    this.stopLoop()
    this.over = true
    this.inputInfo = VARIANT + ' - ' + lastInput + ' - paso ' + tickMs + 'ms'
    buzz(200)
    this.saveBest()
  },

  placeFood() {
    for (let guard = 0; guard < 300; guard++) {
      const x = Math.floor(Math.random() * COLS)
      const y = Math.floor(Math.random() * ROWS)
      if (board[y][x] === 'e') {
        food = { x: x, y: y }
        this.setCell(x, y, 'f')
        return
      }
    }
  },

  // --- entrada ---

  setDir(d, src) {
    lastInput = src + ':' + d
    if (this.over) return
    if (opposite(d, dir)) return
    pending = d
    this.arrow = ARROWS[d]   // respuesta visual inmediata, sin esperar al paso
  },

  onSwipe(e) {
    const d = e && e.direction
    if (d === 'up' || d === 'down' || d === 'left' || d === 'right') this.setDir(d, 'swipe')
  },

  onTouchStart(e) {
    const p = pointOf(e)
    if (!p) return
    touchX = p.x
    touchY = p.y
  },

  onTouchEnd(e) {
    const p = pointOf(e)
    if (!p) return
    const dx = p.x - touchX
    const dy = p.y - touchY
    if (Math.abs(dx) < 18 && Math.abs(dy) < 18) return
    if (Math.abs(dx) > Math.abs(dy)) this.setDir(dx > 0 ? 'right' : 'left', 'touch')
    else this.setDir(dy > 0 ? 'down' : 'up', 'touch')
  },

  onTap() {
    if (this.over) this.reset()
  },

  onPlay() {
    this.reset()
  },

  onLongPress() {
    this.quit()
  },

  onQuit() {
    this.quit()
  },

  quit() {
    this.stopLoop()
    try {
      if (app && typeof app.terminate === 'function') return app.terminate()
      if (app && typeof app.exit === 'function') return app.exit()
    } catch (e) {
      console.log('terminate: ' + e)
    }
    try {
      if (router && typeof router.back === 'function') router.back()
    } catch (e) {
      console.log('back: ' + e)
    }
  },

  // --- record ---

  loadBest() {
    const self = this
    try {
      storage.get({
        key: 'best',
        success(v) {
          const n = parseInt(v, 10)
          if (n > 0) {
            self.best = n
            self.bestText = 'max ' + n
          }
        }
      })
    } catch (e) {
      console.log('storage.get: ' + e)
    }
  },

  saveBest() {
    if (this.score <= this.best) return
    this.best = this.score
    this.bestText = 'max ' + this.score
    try {
      storage.set({ key: 'best', value: '' + this.score })
    } catch (e) {
      console.log('storage.set: ' + e)
    }
  }
}
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
}

.layer {
  flex-direction: column;
  width: 336px;
  height: 480px;
}

.header {
  width: 336px;
  height: 32px;
  align-items: center;
  justify-content: space-between;
  padding-left: 12px;
  padding-right: 12px;
}

.score {
  font-size: 22px;
  color: #ffffff;
}

.arrow {
  font-size: 20px;
  color: #69f0ae;
}

.best {
  font-size: 13px;
  color: #666666;
}

.board {
  flex-direction: column;
  width: 336px;
  height: 448px;
}

.row {
  flex-direction: row;
  width: 336px;
  height: 28px;
}

.c {
  width: 26px;
  height: 26px;
  margin: 1px;
}

.e {
  background-color: #0d0d0d;
}

.h {
  background-color: #69f0ae;
  border-radius: 7px;
}

.b {
  background-color: #2e7d32;
  border-radius: 5px;
}

.f {
  background-color: #ff5252;
  border-radius: 13px;
}

.overlay {
  width: 336px;
  height: 480px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000dd;
}

.over1 {
  font-size: 28px;
  color: #ff5252;
}

.over2 {
  font-size: 20px;
  color: #ffffff;
  margin-top: 6px;
}

.buttons {
  flex-direction: row;
  justify-content: center;
  margin-top: 18px;
}

.btn {
  font-size: 18px;
  padding-top: 8px;
  padding-bottom: 8px;
  padding-left: 16px;
  padding-right: 16px;
  border-radius: 8px;
  margin-left: 6px;
  margin-right: 6px;
}

.play {
  color: #000000;
  background-color: #69f0ae;
}

.quit {
  color: #ffffff;
  background-color: #444444;
}

.over4 {
  font-size: 10px;
  color: #666666;
  margin-top: 18px;
}
</style>
