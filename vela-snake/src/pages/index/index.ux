<template>
  <stack class="page" onswipe="onSwipe" ontouchstart="onTouchStart" ontouchend="onTouchEnd" onclick="onTap">
    <div class="layer">
      <div class="header">
        <text class="score">{{score}}</text>
        <text class="arrow">{{arrow}}</text>
        <text class="best">{{bestText}}</text>
      </div>
      <stack class="board">
        <div class="cell {{item.cls}}" for="{{cells}}" style="margin-left: {{item.x}}px; margin-top: {{item.y}}px"></div>
      </stack>
    </div>

    <div class="overlay" if="{{over}}">
      <text class="over1">GAME OVER</text>
      <text class="over2">{{score}} puntos</text>
      <text class="over3">toca para jugar</text>
      <text class="over4">{{inputInfo}}</text>
    </div>
  </stack>
</template>

<script>
import brightness from '@system.brightness'
import vibrator from '@system.vibrator'
import storage from '@system.storage'

const COLS = 14
const ROWS = 18
const CELL = 24
const POOL = 80          // celdas reutilizadas: 1 comida + cuerpo maximo
const SPEED_START = 260
const SPEED_MIN = 110
const SPEED_STEP = 7
const ARROWS = { up: '^', down: 'v', left: '<', right: '>' }
const VARIANT = '__VARIANT__'

let snake = []
let dir = 'right'
let pending = null
let food = { x: 7, y: 9 }
let timer = null
let speed = SPEED_START
let running = false
let touchX = 0
let touchY = 0
let lastInput = 'sin entrada'

// Celdas reutilizadas: se mutan sus propiedades (reactivo) en vez de recrear la lista.
function buildPool() {
  const arr = []
  for (let i = 0; i < POOL; i++) {
    arr.push({ x: 0, y: 0, cls: 'off' })
  }
  return arr
}

function opposite(a, b) {
  return (a === 'up' && b === 'down') || (a === 'down' && b === 'up') ||
    (a === 'left' && b === 'right') || (a === 'right' && b === 'left')
}

function pointOf(e) {
  const list = (e && (e.changedTouches || e.touches)) || null
  const t = list && list.length ? list[0] : e
  if (!t) return null
  const x = t.clientX !== undefined ? t.clientX : (t.pageX !== undefined ? t.pageX : t.x)
  const y = t.clientY !== undefined ? t.clientY : (t.pageY !== undefined ? t.pageY : t.y)
  if (typeof x !== 'number' || typeof y !== 'number') return null
  return { x: x, y: y }
}

function buzz(ms) {
  try {
    if (vibrator && typeof vibrator.vibrate === 'function') vibrator.vibrate({ mode: ms })
  } catch (e) {
    console.log('vibrate: ' + e)
  }
}

export default {
  private: {
    score: 0,
    best: 0,
    bestText: '',
    arrow: '>',
    over: false,
    inputInfo: '',
    cells: buildPool()
  },

  onInit() {
    this.loadBest()
  },

  onShow() {
    try {
      brightness.setKeepScreenOn({ keepScreenOn: true })
    } catch (e) {
      console.log('keepScreenOn: ' + e)
    }
    this.reset()
  },

  onHide() {
    this.stopLoop()
  },

  onDestroy() {
    this.stopLoop()
  },

  // --- ciclo de juego ---

  reset() {
    const midY = Math.floor(ROWS / 2)
    snake = [{ x: 4, y: midY }, { x: 3, y: midY }, { x: 2, y: midY }]
    dir = 'right'
    pending = null
    speed = SPEED_START
    this.score = 0
    this.arrow = ARROWS[dir]
    this.over = false
    this.placeFood()
    this.draw()
    this.startLoop()
  },

  startLoop() {
    const self = this
    this.stopLoop()
    running = true
    timer = setInterval(function () {
      self.tick()
    }, speed)
  },

  stopLoop() {
    running = false
    if (timer) {
      clearInterval(timer)
      timer = null
    }
  },

  // Cambiar la velocidad exige recrear el intervalo.
  retime() {
    if (running) this.startLoop()
  },

  tick() {
    if (this.over) return

    if (pending && !opposite(pending, dir)) {
      dir = pending
      this.arrow = ARROWS[dir]
    }
    pending = null

    const head = snake[0]
    let nx = head.x
    let ny = head.y
    if (dir === 'up') ny--
    else if (dir === 'down') ny++
    else if (dir === 'left') nx--
    else nx++

    if (nx < 0 || ny < 0 || nx >= COLS || ny >= ROWS) return this.gameOver()
    for (let i = 0; i < snake.length - 1; i++) {
      if (snake[i].x === nx && snake[i].y === ny) return this.gameOver()
    }

    snake.unshift({ x: nx, y: ny })

    if (nx === food.x && ny === food.y) {
      this.score = this.score + 1
      buzz(30)
      this.placeFood()
      if (speed > SPEED_MIN) {
        speed = Math.max(SPEED_MIN, speed - SPEED_STEP)
        this.retime()
      }
    } else {
      snake.pop()
    }

    this.draw()
  },

  gameOver() {
    this.stopLoop()
    this.over = true
    this.inputInfo = VARIANT + ' · ' + lastInput
    buzz(200)
    this.saveBest()
  },

  placeFood() {
    for (let guard = 0; guard < 200; guard++) {
      const x = Math.floor(Math.random() * COLS)
      const y = Math.floor(Math.random() * ROWS)
      let hit = false
      for (let i = 0; i < snake.length; i++) {
        if (snake[i].x === x && snake[i].y === y) {
          hit = true
          break
        }
      }
      if (!hit) {
        food = { x: x, y: y }
        return
      }
    }
  },

  draw() {
    const cells = this.cells
    let n = 0

    cells[n].x = food.x * CELL
    cells[n].y = food.y * CELL
    cells[n].cls = 'food'
    n++

    for (let i = 0; i < snake.length && n < POOL; i++, n++) {
      cells[n].x = snake[i].x * CELL
      cells[n].y = snake[i].y * CELL
      cells[n].cls = i === 0 ? 'head' : 'body'
    }
    for (; n < POOL; n++) {
      cells[n].cls = 'off'
    }
  },

  // --- entrada ---

  setDir(d, src) {
    lastInput = src + ':' + d
    if (this.over) return
    if (!opposite(d, dir)) pending = d
  },

  onSwipe(e) {
    const d = e && e.direction
    if (d === 'up' || d === 'down' || d === 'left' || d === 'right') this.setDir(d, 'swipe')
  },

  onTouchStart(e) {
    const p = pointOf(e)
    if (!p) return
    touchX = p.x
    touchY = p.y
  },

  // Respaldo por si el evento swipe no llega: se deduce del desplazamiento.
  onTouchEnd(e) {
    const p = pointOf(e)
    if (!p) return
    const dx = p.x - touchX
    const dy = p.y - touchY
    if (Math.abs(dx) < 18 && Math.abs(dy) < 18) return
    if (Math.abs(dx) > Math.abs(dy)) this.setDir(dx > 0 ? 'right' : 'left', 'touch')
    else this.setDir(dy > 0 ? 'down' : 'up', 'touch')
  },

  onTap() {
    if (this.over) this.reset()
  },

  // --- record ---

  loadBest() {
    const self = this
    try {
      storage.get({
        key: 'best',
        success(v) {
          const n = parseInt(v, 10)
          if (n > 0) {
            self.best = n
            self.bestText = 'max ' + n
          }
        }
      })
    } catch (e) {
      console.log('storage.get: ' + e)
    }
  },

  saveBest() {
    if (this.score <= this.best) return
    this.best = this.score
    this.bestText = 'max ' + this.score
    try {
      storage.set({ key: 'best', value: '' + this.score })
    } catch (e) {
      console.log('storage.set: ' + e)
    }
  }
}
</script>

<style>
.page {
  width: 336px;
  height: 480px;
  background-color: #000000;
}

.layer {
  flex-direction: column;
  width: 336px;
  height: 480px;
}

.header {
  width: 336px;
  height: 40px;
  align-items: center;
  justify-content: space-between;
  padding-left: 12px;
  padding-right: 12px;
}

.score {
  font-size: 24px;
  color: #ffffff;
}

.arrow {
  font-size: 22px;
  color: #69f0ae;
}

.best {
  font-size: 14px;
  color: #666666;
}

.board {
  width: 336px;
  height: 432px;
  background-color: #060d06;
}

.cell {
  width: 24px;
  height: 24px;
}

.head {
  background-color: #69f0ae;
  border-radius: 7px;
}

.body {
  background-color: #2e7d32;
  border-radius: 5px;
}

.food {
  background-color: #ff5252;
  border-radius: 12px;
}

.off {
  width: 0px;
  height: 0px;
}

.overlay {
  width: 336px;
  height: 480px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000cc;
}

.over1 {
  font-size: 30px;
  color: #ff5252;
}

.over2 {
  font-size: 22px;
  color: #ffffff;
  margin-top: 8px;
}

.over3 {
  font-size: 16px;
  color: #9e9e9e;
  margin-top: 14px;
}

.over4 {
  font-size: 11px;
  color: #555555;
  margin-top: 16px;
}
</style>
